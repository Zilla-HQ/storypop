# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
BUSINESS_NAME=StoryPop
BUSINESS_ADDRESS="123 Main St, Wilmington, DE 19801"
SUPPORT_EMAIL=hello@storypop.shop
ADMIN_EMAIL=jack@seifdn.org

# ===== Supabase / Drizzle =====
# Prefer the Supavisor transaction pooler (port 6543) for serverless —
# Project Settings → Database → "Connection pooling" → "Transaction" mode.
# postgresql://postgres.PROJECTREF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ===== Clerk (admin auth only) =====
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# ===== Stripe =====
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# ===== Inngest =====
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ===== Anthropic (Claude — story generation + email drafting) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ===== Resend (email) =====
RESEND_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=
# Sender domain used for transactional emails. Single domain for B2C.
SENDER_DOMAINS=mail.storypop.shop
SENDER_FROM_NAME=Storypop

# ===== Cloudflare R2 (book pages + final PDFs) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=storypop-books
R2_PUBLIC_URL=

# ===== PostHog =====
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_API_KEY=

# ===== Operational caps =====
DAILY_SEND_CAP=500
PREVIEW_DAILY_CAP=500
FULFILLMENT_DAILY_BUDGET_CENTS=100000

# Pricing (overridable in admin settings; these are bootstrap defaults)
PRICING_STANDARD_CENTS=7900
PRICING_PREMIUM_CENTS=14900
PRICING_RUSH_CENTS=19900

# ===== Meta (Pixel + Conversions API + Marketing API) =====
# ONE System User access token covers every Meta call (CAPI events,
# campaign management, insights). Generate at Meta Business Settings ->
# Users -> System Users -> Generate New Token with scopes:
# ads_management + ads_read.
#
# StoryPop's ad account is provisioned under the Zilla parent BM so it
# inherits BM trust. See docs/growth-plan.md.
#
# Legacy env names (META_CONVERSIONS_API_TOKEN, META_CAPI_ACCESS_TOKEN,
# META_ADS_ACCESS_TOKEN) still resolve via lib/meta-token.ts during the
# rename window. New deploys: set META_ACCESS_TOKEN.
META_ACCESS_TOKEN=
NEXT_PUBLIC_META_PIXEL_ID=
META_AD_ACCOUNT_ID=          # numeric, no "act_" prefix
META_BM_ID=1952475115474490   # Zilla parent BM
META_TEST_EVENT_CODE=         # optional — paste during initial setup
META_API_VERSION=v19.0

# ===== StoryPop SKU pricing (one-time payments) =====
PRICING_PDF_CENTS=1499
PRICING_SOFTCOVER_CENTS=2999
PRICING_HARDCOVER_CENTS=4499
PRICING_GIFT_BUNDLE_CENTS=6999
STRIPE_PRICE_PDF=
STRIPE_PRICE_SOFTCOVER=
STRIPE_PRICE_HARDCOVER=
STRIPE_PRICE_BUNDLE=

# ===== fal.ai (image generation + LoRA character lock) =====
FAL_API_KEY=
FAL_LORA_BASE_MODEL=fal-ai/flux-lora
FAL_LORA_TRAIN_MODEL=fal-ai/flux-lora-fast-training

# ===== Lulu xPress (print on demand) =====
# Sandbox first; flip LULU_BASE_URL after one verified print delivery.
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_BASE_URL=https://api.sandbox.lulu.com   # prod: https://api.lulu.com

# ===== Printful (gift-bundle plush) =====
PRINTFUL_API_KEY=

# ===== Privacy / compliance =====
PHOTO_RETENTION_DAYS=30
